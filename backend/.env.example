# Copia este archivo como ".env" (en la misma carpeta backend/) y rellena los valores reales.
# El archivo ".env" NUNCA debe subirse a GitHub (ya está en .gitignore).

# Clave secreta para firmar los tokens JWT (login, registro).
# Puede ser cualquier texto largo y aleatorio. Ejemplo para generar uno:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_KEY=

# Credenciales del correo que envía los emails de verificación (Gmail).
# USER_PASSWORD debe ser una "contraseña de aplicación" de Gmail, no tu contraseña normal.
# Se genera en: https://myaccount.google.com/apppasswords
USER_EMAIL=
USER_PASSWORD=

# Credenciales de Cloudinary (para subir imágenes de productos).
# Se obtienen en el dashboard de https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
